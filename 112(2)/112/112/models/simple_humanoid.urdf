<?xml version="1.0" ?>
<robot name="simple_humanoid">

  <!-- 材质 -->
  <material name="blue">
    <color rgba="0.2 0.6 0.8 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.2 0.2 1.0"/>
  </material>

  <!-- 躯干 -->
  <link name="torso">
    <inertial>
      <mass value="15.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.4 0.2 0.5"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.4 0.2 0.5"/>
      </geometry>
    </collision>
  </link>

  <!-- 左腿 -->
  <link name="left_leg">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.2 0.2 0.4"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.2 0.2 0.4"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_hip" type="revolute">
    <parent link="torso"/>
    <child link="left_leg"/>
    <origin xyz="0 -0.15 -0.2"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.8" upper="0.8" effort="100" velocity="1.0"/>
  </joint>

  <!-- 右腿（省略，与左腿对称）... -->

  <!-- 球拍手臂 -->
  <link name="racket_arm">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.1 0.1 0.6"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.6"/>
      </geometry>
    </collision>
  </link>

  <joint name="arm_joint" type="revolute">
    <parent link="torso"/>
    <child link="racket_arm"/>
    <origin xyz="0.2 0 0.2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="100" velocity="2.0"/>
  </joint>

</robot>